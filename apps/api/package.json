{
  "name": "@urbanspoon/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ENABLE_SANDBOX_PAYMENTS=true nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:seed:demo": "dotenv -e ../../.env -- tsx prisma/demo-seed.ts"
  },
  "dependencies": {
    "@nestjs/config": "^12.0.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "@urbanspoon/contracts": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^7.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/nodemailer": "^6.4.19",
    "@types/node": "^22.18.6",
    "prisma": "6.19.3",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
