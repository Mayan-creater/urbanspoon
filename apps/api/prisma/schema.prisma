model RestaurantSettlement {
  id                        String                     @id @default(uuid()) @db.Uuid
  restaurantId              String                     @db.Uuid
  periodStart               DateTime
  periodEnd                 DateTime
  currency                  String                     @db.VarChar(3)
  grossItemMinor            Int
  restaurantDiscountMinor   Int
  refundAdjustmentMinor     Int
  commissionBasisMinor      Int
  commissionMinor           Int
  netAmountMinor            Int
  status                    RestaurantSettlementStatus @default(DRAFT)
  generatedByUserId         String                     @db.Uuid
  approvedByUserId          String?                    @db.Uuid
  approvedAt                DateTime?
  paidAt                    DateTime?
  externalTransferReference String?                    @db.VarChar(160)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  restaurant                Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  generatedBy               User                       @relation("SettlementGenerator", fields: [generatedByUserId], references: [id], onDelete: Restrict)
  approvedBy                User?                      @relation("SettlementApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  items                     RestaurantSettlementItem[]
  adjustments               SettlementAdjustment[]

  @@unique([restaurantId, periodStart, periodEnd, currency])
  @@index([status, periodEnd])
  @@index([restaurantId, periodStart, periodEnd])
}

model RestaurantSettlementItem {
  id                      String               @id @default(uuid()) @db.Uuid
  settlementId            String               @db.Uuid
  orderId                 String               @unique @db.Uuid
  commissionRuleId        String?              @db.Uuid
  commissionRuleVersion   Int?
  grossItemMinor          Int
  restaurantDiscountMinor Int
  refundAdjustmentMinor   Int
  commissionBasisMinor    Int
  commissionMinor         Int
  netAmountMinor          Int
  createdAt               DateTime             @default(now())
  settlement              RestaurantSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  order                   Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commissionRule          CommissionRule?      @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)

  @@index([settlementId, createdAt])
}

model SettlementAdjustment {
  id           String               @id @default(uuid()) @db.Uuid
  settlementId String               @db.Uuid
  actorUserId  String               @db.Uuid
  amountMinor  Int
  currency     String               @db.VarChar(3)
  reason       String               @db.VarChar(500)
  createdAt    DateTime             @default(now())
  settlement   RestaurantSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  actor        User                 @relation("SettlementAdjustmentActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([settlementId, createdAt])
}
