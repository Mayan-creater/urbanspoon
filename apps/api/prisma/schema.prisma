  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("CateringQuoteAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([requestId, restaurantId, revision])
  @@index([requestId, status, validUntil])
  @@index([restaurantId, status, createdAt])
}

model SupportCase {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  assignedToUserId  String?           @db.Uuid
  orderId           String?           @db.Uuid
  idempotencyKey    String
  category          SupportCategory
  priority          SupportPriority   @default(NORMAL)
  status            SupportCaseStatus @default(OPEN)
  subject           String            @db.VarChar(120)
  resolutionSummary String?           @db.VarChar(1000)
  customerOutcome   String?           @db.VarChar(500)
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation("SupportCaseOwner", fields: [userId], references: [id], onDelete: Restrict)
  assignedTo        User?             @relation("SupportCaseAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages          SupportMessage[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, updatedAt])
  @@index([assignedToUserId, status, updatedAt])
  @@index([status, priority, createdAt])
  @@index([orderId])
}

model SupportMessage {
  id           String      @id @default(uuid()) @db.Uuid
  caseId       String      @db.Uuid
  authorUserId String      @db.Uuid
  body         String      @db.VarChar(4000)
  isInternal   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  supportCase  SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author       User        @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([caseId, isInternal, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  signatureValid  Boolean
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
}

model DeliveryPartner {
  id                    String                            @id @default(uuid()) @db.Uuid
  userId                String                            @unique @db.Uuid
  marketRegion          String                            @default("IN") @db.VarChar(2)
  verificationStatus    DeliveryPartnerVerificationStatus @default(PENDING)
  availability          DeliveryPartnerAvailability       @default(OFFLINE)
  vehicleType           String
  verificationProvider  String?
  verificationReference String?
  verificationReason    String?
  verifiedAt            DateTime?
  verifiedByUserId      String?                           @db.Uuid
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  user                  User                              @relation("DeliveryPartnerOwner", fields: [userId], references: [id], onDelete: Restrict)
  verifiedBy            User?                             @relation("DeliveryPartnerVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  deliveries            Delivery[]
  assignments           DeliveryAssignment[]
  locations             PartnerLocation[]
  earnings              PartnerEarning[]
  payouts               PartnerPayout[]
  evidence              DeliveryEvidence[]

  @@index([verificationStatus, availability, updatedAt])
}

model Delivery {
  id                          String                  @id @default(uuid()) @db.Uuid
  orderId                     String                  @unique @db.Uuid
  deliveryPartnerId           String?                 @db.Uuid
  status                      DeliveryStatus          @default(PENDING_ASSIGNMENT)
  deliveryOtpHash             String                  @db.VarChar(64)
  estimatedPreparationMinutes Int                     @default(20)
  estimatedReadyAt            DateTime?
  dispatchAt                  DateTime?
  failureReason               String?
  assignedAt                  DateTime?
  arrivedAtRestaurantAt       DateTime?
  pickedUpAt                  DateTime?
  arrivedAt                   DateTime?
  deliveredAt                 DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  order                       Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  deliveryPartner             DeliveryPartner?        @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  assignments                 DeliveryAssignment[]
  statusHistory               DeliveryStatusHistory[]
  locations                   PartnerLocation[]
  earnings                    PartnerEarning[]
  evidence                    DeliveryEvidence[]

  @@index([status, createdAt])
  @@index([deliveryPartnerId, status, updatedAt])
}

model DeliveryAssignment {
  id                String                   @id @default(uuid()) @db.Uuid
  deliveryId        String                   @db.Uuid
  deliveryPartnerId String                   @db.Uuid
  status            DeliveryAssignmentStatus @default(OFFERED)
  offeredAt         DateTime                 @default(now())
  expiresAt         DateTime
  respondedAt       DateTime?
  rejectionReason   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  delivery          Delivery                 @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryPartner   DeliveryPartner          @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)

  @@index([deliveryPartnerId, status, expiresAt])
  @@index([deliveryId, status, offeredAt])
}

model DeliveryStatusHistory {
  id            String          @id @default(uuid()) @db.Uuid
  deliveryId    String          @db.Uuid
  actorUserId   String?         @db.Uuid
  fromStatus    DeliveryStatus?
  toStatus      DeliveryStatus
  reason        String?
  correlationId String?
  createdAt     DateTime        @default(now())
  delivery      Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  actor         User?           @relation("DeliveryStatusEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
}

model PartnerLocation {
  id                String          @id @default(uuid()) @db.Uuid
  deliveryPartnerId String          @db.Uuid
  deliveryId        String?         @db.Uuid
  latitude          Float
  longitude         Float
  accuracyM         Float?
  recordedAt        DateTime        @default(now())
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  delivery          Delivery?       @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([deliveryPartnerId, recordedAt])
  @@index([deliveryId, recordedAt])
}

model PartnerEarning {
  id                String               @id @default(uuid()) @db.Uuid
  deliveryPartnerId String               @db.Uuid
  deliveryId        String               @db.Uuid
  payoutId          String?              @db.Uuid
  earningType       PartnerEarningType
  amountMinor       Int
  currency          String               @db.VarChar(3)
  calculation       Json?
  status            PartnerEarningStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deliveryPartner   DeliveryPartner      @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  delivery          Delivery             @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  payout            PartnerPayout?       @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@unique([deliveryId, earningType])
  @@index([deliveryPartnerId, status, createdAt])
  @@index([payoutId])
}

model DeliveryEvidence {
  id                String               @id @default(uuid()) @db.Uuid
  storageId         String               @unique @db.Uuid
  deliveryPartnerId String               @db.Uuid
  deliveryId        String?              @db.Uuid
  uploadedByUserId  String               @db.Uuid
  evidenceType      DeliveryEvidenceType
  originalFilename  String               @db.VarChar(180)
  contentType       String               @db.VarChar(80)
  sizeBytes         Int
  sha256            String               @db.Char(64)
  createdAt         DateTime             @default(now())
  deliveryPartner   DeliveryPartner      @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  delivery          Delivery?            @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  uploadedBy        User                 @relation("DeliveryEvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([deliveryPartnerId, evidenceType, createdAt])
  @@index([deliveryId, evidenceType, createdAt])
}

model PartnerPayout {
  id                String              @id @default(uuid()) @db.Uuid
  deliveryPartnerId String              @db.Uuid
  requestedByUserId String              @db.Uuid
  approvedByUserId  String?             @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  amountMinor       Int
  currency          String              @db.VarChar(3)
  provider          String              @default("MANUAL") @db.VarChar(32)
  status            PartnerPayoutStatus @default(REQUESTED)
  idempotencyKey    String              @unique
  providerReference String?
  rejectionReason   String?
  requestedAt       DateTime            @default(now())
  approvedAt        DateTime?
  paidAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deliveryPartner   DeliveryPartner     @relation(fields: [deliveryPartnerId], references: [id], onDelete: Restrict)
  requestedBy       User                @relation("PartnerPayoutRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?               @relation("PartnerPayoutApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  earnings          PartnerEarning[]

  @@index([deliveryPartnerId, status, requestedAt])
  @@index([status, requestedAt])
